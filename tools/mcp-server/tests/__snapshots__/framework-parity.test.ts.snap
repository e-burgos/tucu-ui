  "hubPageCode": "import { lazy } from 'react';
import { LucideIcons, HeroCard } from '../../../index';
import { DynamicSectionsPage, type SectionConfig } from '../../components';

const sections: SectionConfig[] = [
  { id: 'documentation', label: 'General Documentation', component: lazy(() => import('./button-sections/DocumentationSection')) },
  { id: 'examples', label: 'Usage Examples', component: lazy(() => import('./button-sections/ExamplesSection')) },
  { id: 'playground', label: 'Playground', component: lazy(() => import('./button-sections/PlaygroundSection')) },
];

export function ButtonPage() {
  return (
    <DynamicSectionsPage
      hideHeroInSubSections
      sections={sections}
      hero={
        <HeroCard
          title="Button Hub"
          description="Primary action button with multiple variants and sizes. Renders the \`<button>\` directly (no wrapper) unless \`tooltip\` is set; then \`wrapperClassName\` styles the wrapper. \`type\` defaults to \`"button"\`. \`className\` is merged with tailwind-merge, so \`h-*\`, \`bg-*\` or \`text-*\` overrides win. Font size scales with \`size\` (xs/tiny/mini 12px, small 13px, medium 14px, large 16px). \`ghost\` has a 2px border, \`outline\` a 1px border."
          githubButton
          getStartedButton
          docsButton="introduction"
          icon={
            <div className="w-16 h-16 sm:w-20 sm:h-20 md:w-24 md:h-24 bg-linear-to-br from-indigo-500 via-purple-500 to-pink-500 rounded-full flex items-center justify-center shadow-lg border border-indigo-500/50">
              <LucideIcons.BookOpen className="w-8 h-8 sm:w-10 sm:h-10 md:w-12 md:h-12 text-white filter drop-shadow-lg" />
            </div>
          }
        />
      }
    />
  );
}

export default ButtonPage;",
  "playgroundSectionCode": "/* eslint-disable @typescript-eslint/no-explicit-any */
import React from 'react';
import {
  HeroCard,
  LucideIcons,
  Button
} from '../../../../index';
import { PropPlayground } from '../../../components/prop-playground';

const PlaygroundSection: React.FC = () => {
  return (
    <div className="flex flex-col gap-8">
      <HeroCard
        title="Button Playground"
        description="Interact with the props controls below to modify the Button component in real-time."
        icon={
          <div className="w-16 h-16 sm:w-20 sm:h-20 bg-linear-to-br from-indigo-500 via-purple-500 to-pink-500 rounded-full flex items-center justify-center shadow-lg">
            <LucideIcons.Wand2 className="w-8 h-8 sm:w-10 sm:h-10 text-white" />
          </div>
        }
      />

      <PropPlayground
        componentName="Button"
        defaultValues={{
          variant: 'solid',
          size: 'large',
        }}
        controlOverrides={[
          {
        name: 'variant',
        type: 'select',
        options: ['solid', 'ghost', 'outline', 'transparent'],
        description: 'variant variant option',
      },
          {
        name: 'size',
        type: 'select',
        options: ['large', 'medium', 'small', 'mini', 'tiny', 'xs'],
        description: 'size variant option',
      },
        ]}
        includeProps={[
          'variant', 'size'
        ]}
      >
        {(props: any) => {
          return (
            <div className="w-full flex justify-center p-6 bg-gray-50 dark:bg-gray-800/40 rounded-lg">
              <Button
                variant={props.variant}
                size={props.size}
              />
            </div>
          );
        }}
      </PropPlayground>
    </div>
  );
};

export default PlaygroundSection;",
  "suggestedPaths": {
    "docsSection": "ui/tucu-ui/src/demo/pages/button/button-sections/DocumentationSection.tsx",
    "examplesSection": "ui/tucu-ui/src/demo/pages/button/button-sections/ExamplesSection.tsx",
    "hubPage": "ui/tucu-ui/src/demo/pages/button/ButtonPage.tsx",
    "playgroundSection": "ui/tucu-ui/src/demo/pages/button/button-sections/PlaygroundSection.tsx",
  },
}
`;

exports[`framework parity: vite output is unchanged > form fields - no framework 1`] = `
{
  "componentCode": "import { Button, Checkbox, Form, Input, Select, Textarea } from '@e-burgos/tucu-ui';
import { z } from 'zod';

const customFormSchema = z.object({
  email: z.string().email("Invalid email"),
  bio: z.string().optional(),
  role: z.string().optional(),
  ok: z.boolean().optional(),
});

type CustomFormData = z.infer<typeof customFormSchema>;

export function CustomForm() {
  const handleSubmit = (data: CustomFormData) => {
    console.log(data);
  };

  return (
    <Form onSubmit={handleSubmit} defaultValues={{ email: '', bio: '', role: '', ok: false }}>
      {({ register, setValue, watch, formState: { errors } }) => (
        <>
          <Input
            label="Email"
            type="email"
            variant="ghost"
            placeholder="Enter email"
            {...register('email')}
            error={errors.email?.message}
          />
          <Textarea
            label="Bio"
            variant="ghost"
            placeholder="Enter bio"
            rows={3}
            {...register('bio')}
            error={errors.bio?.message}
          />
          <Select
            label="Role"
            variant="ghost"
            options={[{ name: 'Admin', value: 'admin' }, { name: 'User', value: 'user' }]}
            value={watch('role')}
            onSelect={(val) => setValue('role', val)}
          />
          <Checkbox
            label="OK"
            checked={watch('ok')}
            onChange={(val) => setValue('ok', val)}
          />
          <Button variant="solid" size="medium" type="submit">
            Submit
          </Button>
        </>
      )}
    </Form>
  );
}",
  "imports": [
    "import { Button, Checkbox, Form, Input, Select, Textarea } from '@e-burgos/tucu-ui';",
    "import { z } from 'zod';",
  ],
  "types": "interface CustomFormData {
  email: string;
  bio: string;
  role: string;
  ok: boolean;
}",
  "validationCode": "import { z } from 'zod';

const customFormSchema = z.object({
  email: z.string().email("Invalid email"),
  bio: z.string().optional(),
  role: z.string().optional(),
  ok: z.boolean().optional(),
});

type CustomFormData = z.infer<typeof customFormSchema>;",
}
`;

exports[`framework parity: vite output is unchanged > form pattern - no framework 1`] = `
{
  "componentCode": "import { Form, Input, Button } from '@e-burgos/tucu-ui';
import { z } from 'zod';

const loginSchema = z.object({
  email: z.string().email("Invalid email"),
  password: z.string().min(6, "Min 6 characters"),
});

type LoginFormData = z.infer<typeof loginSchema>;

export function LoginForm() {
  const handleSubmit = (data: LoginFormData) => {
    console.log(data);
  };

  return (
    <Form onSubmit={handleSubmit} defaultValues={{ email: '', password: '' }}>
      {({ register, formState: { errors } }) => (
        <>
          <Input
            label="Email"
            type="email"
            placeholder="you@example.com"
            variant="ghost"
            {...register('email')}
            error={errors.email?.message}
          />
          <Input
            label="Password"
            type="password"
            placeholder="••••••••"
            variant="ghost"
            {...register('password')}
            error={errors.password?.message}
          />
          <Button variant="solid" size="medium" type="submit">
            Sign In
          </Button>
        </>
      )}
    </Form>
  );
}",
  "description": "Login form with email and password fields.",
  "imports": [
    "import { Form, Input, Textarea, Select, Switch, Button } from '@e-burgos/tucu-ui';",
    "import { z } from 'zod';",
