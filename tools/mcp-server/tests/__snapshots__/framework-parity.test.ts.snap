{
  "componentCode": "import { DataTable, TanstackTable } from '@e-burgos/tucu-ui';

// Styles are not auto-imported by the library. Add once in your app entry:
// import '@e-burgos/tucu-ui/styles';

export interface Item {
  id: string;
  name: string;
  createdAt: string;
}

export interface ItemTableProps {
  data: Item[];
}

const TABLE_ID = 'item-table';

const itemColumns: TanstackTable.ColumnDef<Item, Item>[] = [
  {
    id: 'id',
    accessorKey: 'id',
    header: 'ID',
    size: 80,
  },
  {
    id: 'name',
    accessorKey: 'name',
    header: 'Name',
  },
  {
    id: 'createdAt',
    accessorKey: 'createdAt',
    header: 'Created At',
    cell: ({ row }) => new Date(row.original.createdAt).toLocaleDateString(),
  },
];

export function ItemTable({
  data,
}: ItemTableProps) {
  return (
    <DataTable
      tableId={TABLE_ID}
      data={data}
      columns={itemColumns}
      showHeader
      pagination={{ showPagination: true, rowsInfo: true }}
    />
  );
}",
  "imports": [
    "import { DataTable, TanstackTable } from '@e-burgos/tucu-ui';",
  ],
  "notes": [
    "tableId ('item-table') must be unique and stable: it keys the persisted state in localStorage ('item-table-datatable') and the cache-version registry.",
    "Every column has an explicit id — required for stable column order, visibility, pinning and sizing state.",
    "Import the CSS once per app: '@e-burgos/tucu-ui/styles' (compiled) or '@e-burgos/tucu-ui/theme' + @source directive with your own Tailwind v4 build.",
    "Columns without an explicit size split the remaining container width evenly; the table body maxHeight defaults to 373px (override via sx.tableContainer).",
    "Persisted state (pagination, sorting, column layout) seeds the table on mount and can shadow prop changes — use pagination.takeDefaultPagination or bump the cache version to reset.",
  ],
  "types": "export interface Item {
  id: string;
  name: string;
  createdAt: string;
}

export interface ItemTableProps {
  data: Item[];
}",
}
`;

exports[`framework parity: vite output is unchanged > datatable rich - no framework 1`] = `
{
  "componentCode": "import { useState } from 'react';
import { DataTable, TanstackTable } from '@e-burgos/tucu-ui';
import type { IRowActions } from '@e-burgos/tucu-ui';

// Styles are not auto-imported by the library. Add once in your app entry:
// import '@e-burgos/tucu-ui/styles';

export interface Invoice {
  id: string;
  amount: number;
}

export interface InvoiceTableProps {
  data: Invoice[];
  totalCount: number;
  onPaginationChange?: (pagination: TanstackTable.PaginationState) => void;
  isLoading?: boolean;
  isError?: boolean;
}

const TABLE_ID = 'invoice-table';

const currencyFormatter = new Intl.NumberFormat('en-US', {
  style: 'currency',
  currency: 'USD',
});

const invoiceColumns: TanstackTable.ColumnDef<Invoice, Invoice>[] = [
  {
    id: 'id',
    accessorKey: 'id',
    header: 'Id',
  },
  {
    id: 'amount',
    accessorKey: 'amount',
    header: 'Amount',
    cell: ({ row }) => currencyFormatter.format(row.original.amount),
  },
];

const invoiceRowActions: IRowActions<Invoice>[] = [
  {
    action: 'edit',
    label: () => 'Edit',
    onClick: (row) => {
      console.log('edit', row.original);
    },
  },
];

export function InvoiceTable({
  data,
  totalCount,
  onPaginationChange,
  isLoading,
  isError,
}: InvoiceTableProps) {
  const [pagination, setPagination] =
    useState<TanstackTable.PaginationState>({ pageIndex: 0, pageSize: 10 });

  const handlePaginationChange = (next: TanstackTable.PaginationState) => {
    setPagination(next);
    // DataTable already synced its persisted store; refetch your page here.
    onPaginationChange?.(next);
  };

  return (
    <DataTable
      tableId={TABLE_ID}
      data={data}
      columns={invoiceColumns}
      showHeader
      pagination={{
        showPagination: true,
        rowsInfo: true,
        serverPagination: {
          totalCount,
          pagination,
          setPagination: handlePaginationChange,
        },
      }}
      rowActions={invoiceRowActions}
      isLoading={isLoading}
      isError={isError}
      stateMessage={{
        noData: 'No invoice records found',
        errorData: 'There was a problem loading invoice data',
        hideContactSupport: true,
      }}
    />
  );
}",
  "imports": [
    "import { useState } from 'react';",
    "import { DataTable, TanstackTable } from '@e-burgos/tucu-ui';",
    "import type { IRowActions } from '@e-burgos/tucu-ui';",
  ],
  "notes": [
    "tableId ('invoice-table') must be unique and stable: it keys the persisted state in localStorage ('invoice-table-datatable') and the cache-version registry.",
    "Every column has an explicit id — required for stable column order, visibility, pinning and sizing state.",
    "Import the CSS once per app: '@e-burgos/tucu-ui/styles' (compiled) or '@e-burgos/tucu-ui/theme' + @source directive with your own Tailwind v4 build.",
    "Columns without an explicit size split the remaining container width evenly; the table body maxHeight defaults to 373px (override via sx.tableContainer).",
    "Persisted state (pagination, sorting, column layout) seeds the table on mount and can shadow prop changes — use pagination.takeDefaultPagination or bump the cache version to reset.",
    "Server pagination: on mount DataTable restores the persisted page/size and pushes it back through setPagination, so your parent refetches the restored page. Pass takeDefaultPagination: true to always start from your own defaults.",
    "A single row action renders as an inline icon; pass forceShowMenuActions to force the "..." menu.",
    "Default stateMessage copy includes a "Contact Support" link to the library author's site — the generated code hides it (hideContactSupport: true); override contactSupportLink to point at your own support page.",
  ],
  "types": "export interface Invoice {
  id: string;
  amount: number;
}

export interface InvoiceTableProps {
  data: Invoice[];
  totalCount: number;
  onPaginationChange?: (pagination: TanstackTable.PaginationState) => void;
  isLoading?: boolean;
  isError?: boolean;
}",
}
`;

