{
  "name": "next-demo",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/next-demo",
  "projectType": "application",
  "tags": [],
  "targets": {
    "sync-lib": {
      "executor": "nx:run-commands",
      "dependsOn": ["tucu-ui:build"],
      "options": {
        "cwd": "apps/next-demo",
        "command": "pnpm sync-lib"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync-lib"],
      "outputs": ["{projectRoot}/out", "{projectRoot}/.next"],
      "options": {
        "cwd": "apps/next-demo",
        "command": "next build"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "dependsOn": ["sync-lib"],
      "options": {
        "cwd": "apps/next-demo",
        "command": "next dev"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/next-demo",
        "command": "eslint ."
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "apps/next-demo",
        "command": "node e2e/check-export.mjs"
      }
    }
  }
}
