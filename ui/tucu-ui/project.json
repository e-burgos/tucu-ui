{
  "name": "tucu-ui",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "ui/tucu-ui/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project tucu-ui --web",
  "targets": {
    "install": {
      "executor": "nx:run-commands",
      "options": {
        "commands": ["npm install --prefix ui/tucu-ui"]
      }
    },
    "check-use-client": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "ui/tucu-ui",
        "command": "node scripts/check-use-client.mjs"
      }
    },
    "check-entry-isolation": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "ui/tucu-ui",
        "command": "node scripts/check-entry-isolation.mjs"
      }
    },
    "check-no-css-imports": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "ui/tucu-ui",
        "command": "node scripts/check-no-css-imports.mjs"
      }
    }
  }
}
