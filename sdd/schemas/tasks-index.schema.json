{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sdd/schemas/tasks-index.schema.json",
  "title": "SDD Tasks Index (sdd/tasks.json)",
  "description": "Lightweight index of per-cycle task files. Canonical task data lives in each cycle's tasks.json (see cycle-tasks.schema.json). Written only by sdd-orchestrator (cycle start) and sdd-reviewer (cycle close). Regenerate from per-cycle files with: pnpm sdd:rebuild-tasks-index",
  "type": "object",
  "required": ["sdd_version", "specs"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "_comment": { "type": "string" },
    "sdd_version": { "type": "string" },
    "specs": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^spec-[a-z0-9-]+-\\d{3}-[a-z0-9-]+$": {
          "type": "object",
          "required": ["cycles"],
          "additionalProperties": false,
          "properties": {
            "cycles": {
              "type": "object",
              "additionalProperties": false,
              "patternProperties": {
                "^cycle-\\d{2}$": {
                  "type": "object",
                  "required": [
                    "file",
                    "module",
                    "apps",
                    "status",
                    "tasks_total",
                    "tasks_done"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "file": {
                      "type": "string",
                      "pattern": "^sdd/specs/spec-[a-z0-9-]+/cycles/cycle-\\d{2}/tasks\\.json$",
                      "description": "Path to the canonical per-cycle tasks.json"
                    },
                    "module": { "type": "string", "minLength": 1 },
                    "apps": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "pattern": "^(apps|libs|tools)/[a-z][a-z0-9-]*$"
                      }
                    },
                    "status": { "enum": ["in-progress", "completed"] },
                    "tasks_total": { "type": "integer", "minimum": 0 },
                    "tasks_done": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
